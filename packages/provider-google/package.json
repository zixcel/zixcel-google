{
  "name": "@zixcel/provider-google",
  "version": "0.3.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Thin Google Rust-core adapter to Crowsi one-use administrator control",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zixcel/zixcel-google.git",
    "directory": "packages/provider-google"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@crowsi/provider-http-transport": "0.12.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:types && node --test test/*.test.mjs test/*.test.mts",
    "prepack": "npm test",
    "prebuild": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "test:types": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "ai-agents",
    "llm",
    "google-cloud",
    "cloud-administration",
    "cli",
    "automation",
    "local-first",
    "rust"
  ]
}
