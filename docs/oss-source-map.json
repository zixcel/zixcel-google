{
  "repository": "zixcel/zixcel-google",
  "purpose": "Check a Google integration configuration and produce a plan before implementing or enabling the connection.",
  "responsibility_boundary": "Own the named reusable integration/data mechanism. Product roles/UI and operational approvals stay with consumers; transport/custody reuse managed Crowsi components where capabilities fit. Planning-only APIs must remain clearly distinguished from implemented external operations.",
  "packages": [
    {
      "manifest": "Cargo.toml",
      "package": "zixcel-google",
      "ecosystem": "rust",
      "description": "Planning-only Google service connector boundary for Zixcel",
      "interfaces": {
        "lib": "src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [],
        "public_reexports": [
          "boundary::ConnectorError",
          "config::{ConnectorConfig, parse_config}",
          "plan::{ConnectorPlan, PlanStep, build_plan}",
          "reports::{\n    CapabilityReport, DoctorReport, ValidationReport, capabilities, doctor, validation_report,\n}"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "packages/provider-google/package.json",
      "package": "@zixcel/provider-google",
      "ecosystem": "npm",
      "description": "google local administrator operations with one-use Crowsi authorization",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
          }
        },
        "bin": {},
        "main": null,
        "types": null
      },
      "declared_commands": {
        "build": "tsc -p tsconfig.json",
        "test": "npm run build && node --test test/*.test.mjs",
        "prepack": "npm test"
      }
    }
  ],
  "schema_definitions": [],
  "test_sources": [
    "packages/provider-google/test/control.test.mjs",
    "packages/provider-google/test/discovery.test.mjs",
    "packages/provider-google/test/permission-observation.test.mjs",
    "src/boundary.rs",
    "src/unit_tests.rs",
    "tests/connector.rs"
  ],
  "example_sources": [
    "examples/config.toml",
    "playground/provider-operations/README.ja.md",
    "playground/provider-operations/README.md",
    "playground/provider-operations/demo.mjs"
